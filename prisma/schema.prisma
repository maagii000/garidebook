generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- NextAuth (v4) ----------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Level Up Hub ----------
enum Role {
  USER
  ADMIN
}

enum Category {
  children
  fiction
  textbook
  self_help
  biography
}

enum Condition {
  new
  like_new
  good
  used
}

enum Source {
  official
  user
}

enum BookStatus {
  pending
  active
  sold
  rejected
}

enum OrderStatus {
  placed
  cancelled
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentMethod {
  QPAY
  TRANSFER
}

enum PaymentPurpose {
  BOOK
  UPLOAD_FEE
  AD_FEE
  MEMBERSHIP
  MATERIAL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  credit        Int       @default(120)
  role          Role      @default(USER)
  nickname      String?
  bio           String    @default("")
  school        String    @default("")
  interests     String    @default("")
  lookingFor    String    @default("study")
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  books         Book[]    @relation("BookOwner")
  reviews       Review[]
  wishlist      Wishlist[]
  creditTxs     CreditTx[]
  orders        Order[]   @relation("Buyer")
  ads           Ad[]
  materials     Material[]
  materialAccess MaterialAccess[]
  memberships   Membership[]
  swipesSent    Swipe[]   @relation("SwipeFrom")
  swipesGot     Swipe[]   @relation("SwipeTo")
  matchesA      Match[]   @relation("MatchA")
  matchesB      Match[]   @relation("MatchB")
}

model Book {
  id          String     @id @default(cuid())
  title       String
  author      String
  category    Category
  condition   Condition
  description String     @default("")
  source      Source     @default(user)
  status      BookStatus @default(pending)
  priceCash   Int        @default(5000)
  isDigital   Boolean    @default(false)
  fileUrl     String?
  pageCount   Int?
  ownerId     String
  owner       User       @relation("BookOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  images      BookImage[]
  avgRating   Float      @default(0)
  reviewCount Int        @default(0)
  createdAt   DateTime   @default(now())
  reviews     Review[]
  wishlisted  Wishlist[]
  creditTxs   CreditTx[]
  orders      Order[]
  payments    Payment[]
  // Ebook fields (null = physical P2P listing)
  pdfPath     String?
  coverUrl    String?
  pages       Int?
  textReady   Boolean    @default(false)
  allowCredit Boolean    @default(true)
  classificationCode String?
  chunks      BookChunk[]
  aiQueries   AiQuery[]

  @@index([status, source])
  @@index([category])
}

model BookImage {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  url    String
  sort   Int    @default(0)
}

model Review {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  text      String
  createdAt DateTime @default(now())

  @@unique([bookId, userId])
  @@index([bookId])
}

model Wishlist {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
}

model CreditTx {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  bookId    String?
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Order {
  id          String      @id @default(cuid())
  bookId      String
  book        Book        @relation(fields: [bookId], references: [id])
  buyerId     String
  buyer       User        @relation("Buyer", fields: [buyerId], references: [id])
  cashPaid    Int
  creditSpent Int
  status      OrderStatus @default(placed)
  createdAt   DateTime    @default(now())
  payments    Payment[]

  @@index([buyerId])
  @@index([bookId, buyerId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  buyerId       String
  bookId        String?
  book          Book?         @relation(fields: [bookId], references: [id])
  purpose       PaymentPurpose @default(BOOK)
  refId         String?
  amount        Int
  creditSpent   Int           @default(0)
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod @default(QPAY)
  qpayInvoiceId String?
  qpayPaymentId String?
  ebarimtId     String?
  createdAt     DateTime      @default(now())
  paidAt        DateTime?

  @@index([buyerId])
  @@index([qpayInvoiceId])
}

model BookChunk {
  id      String @id @default(cuid())
  bookId  String
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chunkNo Int
  pageNo  Int?
  content String

  @@index([bookId])
}

model AiQuery {
  id         String   @id @default(cuid())
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId     String
  question   String
  answer     String
  chunksUsed Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([bookId, userId])
}

model Setting {
  key   String @id
  value String
}

enum AdStatus {
  pending
  active
  sold
  rejected
}

model Ad {
  id          String   @id @default(cuid())
  title       String
  price       Int
  description String   @default("")
  contact     String   @default("")
  status      AdStatus @default(pending)
  feePaid     Boolean  @default(false)
  paymentId   String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images      AdImage[]
  createdAt   DateTime @default(now())

  @@index([status])
}

model AdImage {
  id    String @id @default(cuid())
  adId  String
  ad    Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)
  url   String
  sort  Int    @default(0)
}

enum MaterialStatus {
  pending
  active
  rejected
}

model Material {
  id          String         @id @default(cuid())
  title       String
  subject     String         @default("")
  description String         @default("")
  filePath    String?
  fileName    String?
  fileSize    Int?
  price       Int            @default(0)
  kind        String         @default("")
  downloads   Int            @default(0)
  status      MaterialStatus @default(pending)
  feePaid     Boolean        @default(false)
  paymentId   String?
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  access      MaterialAccess[]
  createdAt   DateTime       @default(now())

  @@index([status])
}

model MaterialAccess {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, materialId])
  @@index([materialId])
}

enum MembershipPlan {
  BASE
  PRO
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}
model Membership {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      MembershipPlan
  status    MembershipStatus @default(ACTIVE)
  freeTrial Boolean          @default(false)
  paymentId String?
  startsAt  DateTime         @default(now())
  endsAt    DateTime
  createdAt DateTime         @default(now())

  @@index([userId, status])
}

model ChatRoom {
  id        String        @id @default(cuid())
  name      String
  topic     String        @default("")
  matchId   String?       @unique
  match     Match?        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  userName  String   @default("—")
  text      String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

model Swipe {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("SwipeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("SwipeTo", fields: [toId], references: [id], onDelete: Cascade)
  dir       String
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
  @@index([toId])
}

model Match {
  id        String   @id @default(cuid())
  aId       String
  a         User     @relation("MatchA", fields: [aId], references: [id], onDelete: Cascade)
  bId       String
  b         User     @relation("MatchB", fields: [bId], references: [id], onDelete: Cascade)
  chatRoom  ChatRoom?
  createdAt DateTime @default(now())

  @@unique([aId, bId])
}
